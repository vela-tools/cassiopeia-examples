{
    version: "v4",
    dataModel: "dataModel.Weather/SeaConditions",
    // One entity per sea cell. Six geohash characters, about a kilometre across, tell the quarter
    // degree cells apart.
    identity: {
        entityName: "{{ geohash(lat=latitude, lon=longitude, precision=6) }}",
    },
    attributes: {
        location: {
            source: [
                "{{ longitude }}",
                "{{ latitude }}",
            ],
            type: "GeoProperty",
            transformation: "point",
        },
        dateObserved: {
            source: "{{ time }}",
            type: "Property",
            transformation: "datetime",
        },
        // A land cell holds the _FillValue and is never a record, so every record has a temperature
        // and the template needs no guard. The analysis is a 32-bit float, which is read as the
        // shortest decimal that round-trips, so it needs no rounding. CEL is degree Celsius.
        surfaceTemperature: {
            source: "{{ sst }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "CEL",
                },
            },
        },
    },
}
