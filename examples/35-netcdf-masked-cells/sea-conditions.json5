{
    version: "v4",
    dataModel: "dataModel.Weather/SeaConditions",
    // One entity per sea cell. Six geohash characters, about a kilometre across, tell the quarter
    // degree cells apart.
    identity: {
        entityName: "{{ geohash(lat=latitude, lon=longitude, precision=6) }}",
    },
    attributes: {
        location: {
            source: [
                "{{ longitude }}",
                "{{ latitude }}",
            ],
            type: "GeoProperty",
            transformation: "point",
        },
        dateObserved: {
            source: "{{ time }}",
            type: "Property",
            transformation: "datetime",
        },
        // A land cell holds the _FillValue and is never a record, so every record has a temperature
        // and the template needs no guard. The analysis is a 32-bit float, so 21.36 reads back as
        // 21.360000610351562; two decimals are what it holds. CEL is degree Celsius.
        surfaceTemperature: {
            source: "{{ sst | round(precision=2) }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "CEL",
                },
            },
        },
    },
}
