{
    version: "v4",
    dataModel: "BikeRentalShop",
    // The "Where to Get Bikes" folder becomes the `where_to_get_bikes` namespace. Several shops are
    // pinned at more than one branch under the same name, so the name alone would merge the branches
    // into one entity; the geohash of each placemark's point keeps every branch apart.
    identity: {
        entityName: "{{ where_to_get_bikes.properties.name | trim | clean }}-{{ geohash(lat=where_to_get_bikes.geometry.coordinates[1], lon=where_to_get_bikes.geometry.coordinates[0]) }}",
    },
    attributes: {
        name: {
            source: "{{ where_to_get_bikes.properties.name | trim }}",
            type: "Property",
            transformation: "string",
        },
        location: {
            source: "{{ where_to_get_bikes.geometry }}",
            type: "GeoProperty",
            transformation: "geometry",
        },
    },
}
