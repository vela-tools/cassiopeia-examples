{
    version: "v4",
    dataModel: "dataModel.Weather/WeatherObserved",
    // One identity per buoy. station is the variable the file marks with cf_role "timeseries_id",
    // and every record of a buoy carries it, so the day's readings are the same entity observed
    // again. The observedAt on each reading ranks them, and the latest wins.
    identity: {
        entityName: "{{ station }}",
    },
    attributes: {
        stationCode: {
            source: "{{ station }}",
            type: "Property",
            transformation: "string",
        },
        // A moored buoy's position is a station variable, so every record of the buoy holds it.
        location: {
            source: [
                "{{ longitude }}",
                "{{ latitude }}",
            ],
            type: "GeoProperty",
            transformation: "point",
        },
        dateObserved: {
            source: "{{ time }}",
            type: "Property",
            transformation: "datetime",
            properties: {
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        // ERDDAP serves NDBC's temperatures in degrees Celsius. CEL is the UN/CEFACT code for it.
        temperature: {
            source: "{{ ATMP }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "CEL",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        dewPoint: {
            source: "{{ DEWP }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "CEL",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        // The model wants relative humidity as a ratio in [0, 1]; the buoys report a dew point
        // instead. The Magnus formula, with the coefficients of Alduchov and Eskridge (1996), gives
        // the ratio from the dew point and the air temperature. A reading the buoy missed is masked
        // in the file and absent from the record, and arithmetic on an absent field fails, so the
        // computation is guarded.
        relativeHumidity: {
            source: "{% if ATMP is defined and DEWP is defined %}{% set exponent = 17.625 * DEWP / (243.04 + DEWP) - 17.625 * ATMP / (243.04 + ATMP) %}{{ exponent | exp | round(precision=4) }}{% endif %}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "C62",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        // NDBC reports pressure in hectopascals, the unit the model uses. A97 is hectopascal.
        atmosphericPressure: {
            source: "{{ BAR }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "A97",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        windDirection: {
            source: "{{ WD }}",
            type: "Property",
            transformation: "integer",
            properties: {
                unitCode: {
                    source: "DD",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        // NDBC reports wind in metres per second, the unit the model uses. MTS is metre per second.
        windSpeed: {
            source: "{{ WSPD }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "MTS",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
        gustSpeed: {
            source: "{{ GST }}",
            type: "Property",
            transformation: "float",
            properties: {
                unitCode: {
                    source: "MTS",
                },
                observedAt: {
                    source: "{{ time }}",
                    type: "Property",
                    transformation: "datetime",
                },
            },
        },
    },
}
