{
    version: "v4",
    // A plain data model with no published schema: the country list is the one type here that has
    // no Smart Data Model, so it is validated against nothing and used only as a relationship target.
    dataModel: "Country",
    identity: {
        // The country name is the identity, so an airport or airline that names its country as text
        // resolves to the same URN this mapping mints. The source lists some countries once per DAFIF
        // code; collapse-countries.awk has already merged those into one row per name.
        entityName: "{{ this[0] }}",
    },
    attributes: {
        name: {
            source: "{{ this[0] }}",
            type: "Property",
            transformation: "string",
        },
        isoCode: {
            source: "{% if this[1] %}{{ this[1] }}{% endif %}",
            type: "Property",
            transformation: "string",
        },
        // Every DAFIF code the country has, always as a list so the shape does not depend on how many
        // there are: ["UK"] for most, ["GZ", "WE"] for Palestine. The collapsed row holds the codes
        // space-separated; a country with none is guarded off, so the attribute is left out.
        dafifCode: {
            source: "{% if this[2] %}{{ this[2] | split(pat=' ') }}{% endif %}",
            type: "Property",
            transformation: "array",
        },
    },
}
