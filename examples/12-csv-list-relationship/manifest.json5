{
    version: "v1",
    inputs: [
        // The country and aircraft lists are read in their collapsed form, one row per entity id,
        // which the preparation step writes beside the downloads.
        {
            source: "data/countries.csv",
            mapping: "country.json5",
            format: "csv",
        },
        {
            source: "data/aircraft-models.csv",
            mapping: "plane.json5",
            format: "csv",
        },
        {
            source: "data/airports.dat",
            mapping: "airport.json5",
            format: "csv",
        },
        {
            source: "data/airlines.dat",
            mapping: "airline.json5",
            format: "csv",
        },
        {
            source: "data/routes.dat",
            mapping: "route.json5",
            format: "csv",
        },
    ],
    output: {
        target: "file",
        directory: "out",
        context: "none",
        // Validation reports rather than aborts: the four schema-backed types still conform, while
        // the Flight's ListRelationship is off-spec for its model and would fail a strict run.
        validation: {
            mode: "warn",
        },
    },
}
